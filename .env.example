# AI coach: set one key (or both, then pick with AI_PROVIDER=openai|anthropic)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-5.5

# Required in production: signs the session tokens the AI routes require (32+ random chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared rate limiting (Vercel Marketplace → Upstash Redis sets these). Without them, limits are per-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hard cap on AI calls per day across all users (spend backstop). Default 3000.
AI_DAILY_LIMIT=3000

# Extra origins allowed to call the API besides the site's own host (comma-separated), e.g. a custom preview domain.
ALLOWED_ORIGINS=

# Desmos calculator key: request a free production key at desmos.com/api. The demo key is for development only.
NEXT_PUBLIC_DESMOS_KEY=dcb31709b452b1cf9dc26972add0fda6
